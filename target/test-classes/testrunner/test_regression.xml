<suite name="DMVTEK-Retail Application Test Regression Suite" verbose="2"
	thread-count="3" parallel="tests">
	<listeners>
		<listener
			class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
				<listener
					class-name="com.qa.retail.listeners.AnnotationTransformer" />
		<listener
			class-name="com.qa.retail.listeners.TestAllureListener" />
	</listeners>

	<test name="Login Page Test">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.qa.retail.tests.LoginPageTest" />
		</classes>
	</test>

